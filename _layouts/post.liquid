---
layout: default
---
<article class="post">
  <header>
    <h1>{{ page.title }}</h1>
    <p class="affiliation">
      {%- if page.date -%}
        {{ page.date | date: '%B %d, %Y' }}
      {%- else -%}
        Updated {{ page.last_updated | date: '%B %d, %Y' }}
      {%- endif -%}
    </p>
  </header>
  {% if page.url contains '/blog/' %}
    <details class="post-toc post-toc--left topic-nav">
      <summary class="toc-title">Topics</summary>
      <ol>
        {% for area in site.data.topics %}
          <li class="toc-top toc-area">{{ area.area }}</li>
          {% for topic in area.topics %}
            {% assign topic_url = '/blog/' | append: topic.slug | append: '/' %}
            <li class="toc-sub">
              <a
                href="{{ topic_url | relative_url }}"
                {% if page.url == topic_url %}
                  class="is-current" aria-current="page"
                {% endif %}
                >{{ topic.title }}</a
              >
            </li>
          {% endfor %}
        {% endfor %}
      </ol>
    </details>
    <script>
      if (window.matchMedia('(min-width: 1200px)').matches) {
        document.querySelector('.topic-nav').open = true;
      }
    </script>
  {% endif %}
  {% if page.toc %}
    <nav
      class="post-toc post-toc--{{ page.toc.sidebar | default: 'right' }}"
      aria-label="Contents"
      hidden
    >
      <p class="toc-title">Contents</p>
      <ol></ol>
    </nav>
  {% endif %}
  {{ content }}
</article>
