---
layout: default
---
<article class="post">
  <header>
    <h1>{{ page.title }}</h1>
    <p class="affiliation">
      {%- if page.date -%}
        {{ page.date | date: '%B %d, %Y' }}
      {%- else -%}
        Updated {{ page.last_updated | date: '%B %d, %Y' }}
      {%- endif -%}
    </p>
  </header>
  {% if page.toc %}
    <nav
      class="post-toc post-toc--{{ page.toc.sidebar | default: 'right' }}"
      aria-label="Contents"
      hidden
    >
      <p class="toc-title">Contents</p>
      <ol></ol>
    </nav>
  {% endif %}
  {{ content }}
</article>
